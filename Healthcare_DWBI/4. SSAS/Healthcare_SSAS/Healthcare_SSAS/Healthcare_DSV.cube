  <Kpis>
    <Kpi dwd:design-time-name="43ffd881-4aab-4a49-81a0-65db19d2fe84">
      <ID>KPI</ID>
      <Name>No Show Rate</Name>
      <AssociatedMeasureGroupID>Fact Appointment</AssociatedMeasureGroupID>
      <Value>[Measures].[No Show Count] / [Measures].[Appointment Count]</Value>
      <Goal>0.20</Goal>
      <Status>CASE
    WHEN [Measures].[Appointment Count] = 0 THEN 0
    WHEN ([Measures].[No Show Count] / [Measures].[Appointment Count]) &lt;= 0.20 THEN 1
    WHEN ([Measures].[No Show Count] / [Measures].[Appointment Count]) &lt;= 0.25 THEN 0
    ELSE -1
END</Status>
      <Trend>0</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>